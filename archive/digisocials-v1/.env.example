PORT=3001
NODE_ENV=development

# Supabase project URL and client-safe anon/publishable key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Server-only secret. Never prefix this with VITE_ or expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Public web-app origin (local OAuth callback uses the Vite proxy).
PUBLIC_APP_URL=http://localhost:5173
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_RANDOM_KEY

# Optional; required only for Meta OAuth / Facebook Pages / Instagram publishing.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# Optional; required only for LinkedIn OAuth and text publishing.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
